const maxLength = 140

// Slug determinista para anclas (#id). Debe coincidir con el de ProfileDescription.
const slugify = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')

---
<div class="grid md:grid-cols-2 gap-8 my-4 ">
    {
        PROJECTS.map(({title,date, description, tags, image, link, github, inProgress }) => (
            <div id={slugify(title)} class="scroll-mt-24">
                <div class="flex items-center gap-x-2 flex-wrap mb-2">
                    <h3 class="text-2xl font-semibold text-yellow-200">{title}</h3>
                    {inProgress && (
                        <span class="rounded-full text-xs bg-amber-400/20 text-amber-300 border border-amber-400/40 py-1 px-2 font-medium">
                            En desarrollo
                        </span>
                    )}
                </div>
                <p class="ms-2 mb-2 text-xs font-light opacity-80">{date}</p>
                {image ? (
                    <button type="button" class="zoomable-trigger block w-full p-0 border-0 bg-transparent cursor-zoom-in" data-image={image} data-alt={`Captura de pantalla del proyecto ${title}`}>
                        <img loading="lazy" class="rounded shadow-2xl shadow-white/10 mb-4 hover:scale-110 hover:bg-white/10 transition" src={image} alt={`Captura de pantalla del proyecto ${title}`} />
                    </button>
                ) : (
                    <div class="rounded shadow-2xl shadow-white/10 mb-4 aspect-video flex items-center justify-center bg-white/5 border border-white/10 text-white/40 text-sm">
                        Captura pendiente
                    </div>
                )}
                <ul class="flex gap-x-2 flex-row flex-wrap">
                    {tags.map(tag => (
                        <li class="mb-3">
                            <span class={`flex items-center gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}>
                                <tag.icon class="size-6" />
                                {tag.name}
                            </span>
                            
                        </li>
                    ))}
                </ul>
                <p class="description text-lg text-white mb-4 text-pretty" data-full={description}>{description}</p>
                {description.length > maxLength && (
                <a href="#" class="see-more text-blue-500">Ver más</a>
                )}

                <nav class="flex gap-4 mt-2 items-center">

                {link && (
                    <SocialBadge href={link}>
                        <LinkIcon class="size-4 md:size-6" />
                    </SocialBadge>
                )}

                <SocialBadge href={github}>
                    <GithubIcon class="size-4 md:size-6" fill="#fff"/>
                </SocialBadge>

            </nav>
                 
            </div>
        ))
    }
</div>

<div id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4 cursor-zoom-out">
    <img id="lightbox-img" src="" alt="" class="max-h-full max-w-full rounded shadow-2xl" />
</div>

<script>
    const descriptionElements = document.querySelectorAll('.description')
    const maxLength = 140

    descriptionElements.forEach(descriptionElement => {
        const fullText = descriptionElement.getAttribute('data-full');
        if(fullText && fullText.length > maxLength){
            const truncatedText = fullText.substring(0, maxLength) + '...';
            descriptionElement.textContent = truncatedText;
            const seeMoreLink = descriptionElement.nextElementSibling
            if(seeMoreLink){
                seeMoreLink.addEventListener('click', (e) => {
                e.preventDefault();
                if (descriptionElement.textContent === truncatedText) {
                    descriptionElement.textContent = fullText;
                    seeMoreLink.textContent = "Ver menos";
                } else {
                    descriptionElement.textContent = truncatedText;
                    seeMoreLink.textContent = "Ver más";
                }
                });
            }
            
        }

    })

    const lightbox = document.getElementById('lightbox')
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null

    if (lightbox && lightboxImg) {
        const openLightbox = (src: string, alt: string) => {
            lightboxImg.setAttribute('src', src)
            lightboxImg.setAttribute('alt', alt)
            lightbox.classList.remove('hidden')
            lightbox.classList.add('flex')
            document.body.classList.add('overflow-hidden')
        }

        const closeLightbox = () => {
            lightbox.classList.add('hidden')
            lightbox.classList.remove('flex')
            lightboxImg.setAttribute('src', '')
            document.body.classList.remove('overflow-hidden')
        }

        document.querySelectorAll('.zoomable-trigger').forEach(trigger => {
            trigger.addEventListener('click', () => {
                openLightbox(trigger.getAttribute('data-image') ?? '', trigger.getAttribute('data-alt') ?? '')
            })
        })

        lightbox.addEventListener('click', closeLightbox)

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeLightbox()
        })
    }

</script>
