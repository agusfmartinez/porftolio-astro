---
import HTMLIcon from '../icons/HtmlIcon.astro'
import CSSIcon from '../icons/CSS.astro'
import SassIcon from '../icons/Sass.astro'
import JavascriptIcon from '../icons/Javascript.astro'
import BootstrapIcon from '../icons/Bootstrap.astro'
import TailwindIcon from '../icons/Tailwind.astro'
import ReactIcon from '../icons/ReactJs.astro'
import AstroIcon from '../icons/AstroIcon.astro'
import NodeIcon from '../icons/Node.astro'
import GitIcon from '../icons/Git.astro'
import FirebaseIcon from '../icons/Firebase.astro'
import FigmaIcon from '../icons/Figma.astro'
import PhotoshopIcon from '../icons/Photoshop.astro'
import ExpressIcon from '../icons/Express.astro'
import MongoIcon from '../icons/Mongo.astro'
import DockerIcon from '../icons/Docker.astro'
import KubernetesIcon from '../icons/Kubernetes.astro'
import JWTIcon from '../icons/JWT.astro'
import TypeScriptIcon from '../icons/TypeScript.astro'
import NextIcon from '../icons/Next.astro'
import SupabaseIcon from '../icons/Supabase.astro'
import ElectronIcon from '../icons/Electron.astro'
import PythonIcon from '../icons/Python.astro'
import DjangoIcon from '../icons/Django.astro'
import PostgreSQLIcon from '../icons/PostgreSQL.astro'
import FlaskIcon from '../icons/Flask.astro'
import MySQLIcon from '../icons/MySQL.astro'
import RedisIcon from '../icons/Redis.astro'
import PlaywrightIcon from '../icons/Playwright.astro'
import SocketIOIcon from '../icons/SocketIO.astro'
import CloudflareWorkersIcon from '../icons/CloudflareWorkers.astro'
import { getLang, useTranslations } from '../i18n'

const t = useTranslations(getLang(Astro.currentLocale))

// Slug determinista para anclas (#id). Debe coincidir con el de Projects.astro.
const slugify = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')

// `project` = título exacto (en español) en Projects.astro (link al proyecto). `href` = ancla directa (ej. #experiencia).
const WORK = "#experiencia"
const SKILL_GROUPS = [
    {
        label: t.profile.groups.frontend,
        items: [
            { name: "HTML", icon: HTMLIcon, project: "Ojitos Turcos: Amuletos de Protección" },
            { name: "CSS", icon: CSSIcon, project: "App Presupuestos" },
            { name: "Sass", icon: SassIcon, project: "Rocanroles Argentinos" },
            { name: "JavaScript", icon: JavascriptIcon, project: "Ojitos Turcos: Amuletos de Protección" },
            { name: "TypeScript", icon: TypeScriptIcon, project: "WhatsApp Notes" },
            { name: "Bootstrap", icon: BootstrapIcon, project: "Tienda de Curiosidades de Watto" },
            { name: "Tailwind", icon: TailwindIcon, project: "App LetterRock" },
            { name: "ReactJs", icon: ReactIcon, project: "App LetterRock" },
            { name: "Next.js", icon: NextIcon, project: "WhatsApp Notes" },
            { name: "Astro", icon: AstroIcon, project: "MG Consultoría Legal" },
        ],
    },
    {
        label: t.profile.groups.backend,
        items: [
            { name: "NodeJs", icon: NodeIcon, project: "Proyecto Ecommerce Backend" },
            { name: "Express", icon: ExpressIcon, project: "Proyecto Ecommerce Backend" },
            { name: "Python", icon: PythonIcon, href: WORK },
            { name: "Flask", icon: FlaskIcon, href: WORK },
            { name: "Django", icon: DjangoIcon, href: WORK },
            { name: "JWT", icon: JWTIcon, project: "Proyecto Ecommerce Backend" },
            { name: "Socket.io", icon: SocketIOIcon, project: "Trivia Game" },
            { name: "Cloudflare Workers", icon: CloudflareWorkersIcon, project: "Agente Personal WhatsApp" },
        ],
    },
    {
        label: t.profile.groups.databases,
        items: [
            { name: "MongoDB", icon: MongoIcon, project: "Proyecto Ecommerce Backend" },
            { name: "PostgreSQL", icon: PostgreSQLIcon, project: "App LetterRock" },
            { name: "Supabase", icon: SupabaseIcon, project: "App LetterRock" },
            { name: "MySQL", icon: MySQLIcon, href: WORK },
            { name: "Redis", icon: RedisIcon, href: WORK },
            { name: "Firebase", icon: FirebaseIcon, project: "Tienda de Curiosidades de Watto" },
        ],
    },
    {
        label: t.profile.groups.devops,
        items: [
            { name: "Docker", icon: DockerIcon, href: WORK },
            { name: "Kubernetes", icon: KubernetesIcon },
            { name: "Git", icon: GitIcon },
            { name: "Electron", icon: ElectronIcon, project: "WhatsApp CRM" },
            { name: "Playwright", icon: PlaywrightIcon, project: "App Bonos CAI" },
        ],
    },
    {
        label: t.profile.groups.design,
        items: [
            { name: "Figma", icon: FigmaIcon },
            { name: "Photoshop", icon: PhotoshopIcon },
        ],
    },
]
---

<div {... Astro.props}>
    <p class="text-white">{t.profile.intro}</p>

    <div class="flex flex-col gap-5 my-4">
        {SKILL_GROUPS.map((group) => (
            <div>
                <h3 class="text-xs font-semibold uppercase tracking-wider text-sky-200/80 mb-2">{group.label}</h3>
                <div class="grid grid-cols-5 sm:grid-cols-6 md:grid-cols-8 gap-3">
                    {group.items.map(({name, icon: IconComponent, project, href}) => {
                        const target = href ?? (project ? `#${slugify(project)}` : null)
                        const iconClass = "size-12 md:size-14 w-full p-2 border border-white/10 rounded-lg shadow bg-black/20 hover:scale-110 hover:bg-white/10 transition"
                        const tip = href ? `${name} — ${t.profile.seeExperience}` : project ? `${name} — ${t.profile.seeProject}` : name
                        return target ? (
                            <a href={target} title={tip} aria-label={tip}>
                                <IconComponent class={iconClass} />
                            </a>
                        ) : (
                            <div title={name}>
                                <IconComponent class={iconClass} />
                            </div>
                        )
                    })}
                </div>
            </div>
        ))}
    </div>
</div>
