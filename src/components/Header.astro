---
import { getLang, useTranslations, HOME_PATH } from '../i18n'

const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
const otherLang = lang === 'es' ? 'en' : 'es'

const LINKS = [
  { href: '#top', label: t.nav.home },
  { href: '#sobre-mi', label: t.nav.about },
  { href: '#experiencia', label: t.nav.experience },
  { href: '#portfolio', label: t.nav.portfolio },
  { href: '#educacion', label: t.nav.education },
  { href: '#servicios', label: t.nav.services },
  { href: '#contacto', label: t.nav.contact },
]
---
<nav class="fixed w-full z-20 top-0 start-0 bg-gray-800 shadow bg-black/20">
    <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
      <a href="#top" class="flex items-center space-x-3 rtl:space-x-reverse">
        <img src="/projects/logoAM.webp" class="h-8" alt="Agustin Martinez Logo">
      </a>
      <div class="flex md:order-2 space-x-3 md:space-x-0 rtl:space-x-reverse">
        <button data-collapse-toggle="navbar-sticky" type="button" class="button-collapser inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg md:hidden hover:bg-white/10 transition focus:outline-none focus:ring-2 focus:bg-white/10" aria-controls="navbar-sticky" aria-expanded="false">
          <span class="sr-only">Open menu</span>
          <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"/>
          </svg>
        </button>
      </div>
      <div class="items-center justify-between hidden w-full md:flex md:w-auto md:order-1" id="navbar-sticky">
        <ul class="flex flex-col p-4 md:p-0 mt-4 font-medium border border-white/10 rounded-lg bg-gray-800  md:space-x-8 rtl:space-x-reverse md:flex-row md:mt-0 md:border-0 md:bg-transparent md:items-center" id="nav-links">
          {LINKS.map(({ href, label }) => (
            <li>
              <a href={href} class="block py-2 px-3 text-white rounded hover:bg-white/10 md:hover:bg-transparent md:hover:text-yellow-200 md:p-0">{label}</a>
            </li>
          ))}
          <li>
            <a href={HOME_PATH[otherLang]} hreflang={otherLang} lang={otherLang} aria-label={t.nav.switchLabel} title={t.nav.switchLabel} class="block py-2 px-3 text-white rounded hover:bg-white/10 md:py-1 md:px-2 md:border md:border-white/20 md:text-xs md:hover:border-yellow-200 md:hover:text-yellow-200 transition">{t.nav.switchText}</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <script>

  const buttons = document.querySelectorAll('button.button-collapser');
    buttons.forEach((button) => {
    button.addEventListener('click', () => {
        const navLinks = document.getElementById('navbar-sticky');
        if (navLinks) {
            navLinks.classList.toggle('hidden');
        } else {
            console.error('Element with ID "nav-links" not found.');
        }
    });
    });


  </script>
